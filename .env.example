# Anthropic — used by scripts/judge.ts (the model-graded verify rung)
ANTHROPIC_API_KEY=

# OpenAI — hackathon credits
OPENAI_API_KEY=

# Bright Data. `brightdata login` stores credentials itself; `-k/--api-key <key>` overrides
# per-invocation. Env-var precedence is NOT yet confirmed by execution — run
# `brightdata config get` once authenticated and record the result before relying on it.
BRIGHTDATA_API_KEY=

# TrueForge (v0.1.4). Standalone mode = SQLite, no Redis. Set STANDALONE=false for
# Postgres + Redis multi-replica peering.
PORT=8790

# Daytona — TrueForge's sandbox provider. Needs permission to create sandboxes AND to
# create/use the configured snapshot.
DAYTONA_API_KEY=

# The deployed URL the verification harness drives
APP_URL=http://localhost:3000
