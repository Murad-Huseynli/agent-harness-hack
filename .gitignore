# Secrets — never commit
.env
.env.*
!.env.example

# Deps / build
node_modules/
dist/
build/
.next/
__pycache__/
.venv/
*.pyc

# OS / editor
.DS_Store
.vscode/
.vercel

# build info
tsconfig.tsbuildinfo

# verification + demo artifacts (regenerated, uploaded separately)
verify/out/
*.mp4
*.webm

# scraped payloads — the registry is versioned, the harvest is not
scrapers/data/*
!scrapers/data/.gitkeep

# Graphify — extracted knowledge-graph artifacts, never committed
graph.json
GRAPH_REPORT.md
graphify-out/

# Planning artifacts — held back from the public repo until we choose what to publish.
# They contain LifeOS filesystem paths and private-venture detail. Publication is a
# one-way door; adding files later is easy, unpublishing is not.
briefs/
wiki/
